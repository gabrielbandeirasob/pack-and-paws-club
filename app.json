{
  "expo": {
    "name": "Pack & Paws Club",
    "slug": "pack-and-paws-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "packandpaws",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.packandpaws.club"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#203522",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.packandpaws.club",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#203522"
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Pack & Paws Club to access contacts you choose to add as clients."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "784897ee-2e4f-47e0-bb1c-1eacc39d412b"
      }
    },
    "owner": "jarbasdev"
  }
}
